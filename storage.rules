rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImageUnder5Mb() {
      return request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function isConversationParticipant(conversationId) {
      let conversation = firestore.get(
        /databases/(default)/documents/conversations/$(conversationId)
      ).data;
      return signedIn() &&
        (conversation.ownerUid == request.auth.uid ||
         conversation.requesterUid == request.auth.uid);
    }

    match /lost-item-photos/{uid}/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && isImageUnder5Mb();
      allow update, delete: if false;
    }

    match /conversation-photos/{conversationId}/{uid}/{photoId} {
      allow read: if isConversationParticipant(conversationId);
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        isConversationParticipant(conversationId) &&
        isImageUnder5Mb();
      allow update, delete: if false;
    }
  }
}
